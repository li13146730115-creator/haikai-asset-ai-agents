{
  "as_of": "2026-11-08",
  "period": "2026-01-01 至 2026-11-08",
  "scenes": [
    {
      "id": "C01",
      "agent": "contract",
      "title": "履约总览",
      "role": "一线 / 管理者",
      "question": "这份合同目前有哪些需要处理的？",
      "data": "当前合同、账单、核销、保证金、企业信息、变更、项目规则",
      "flow": "锁定合同 → 拉取事实 → 计算指标 → 中台解释 → 结果卡",
      "accept": "HT-A01显示逾期20,000元、保证金缺口10,000元、53天到期。",
      "boundary": "仅当前合同；缺失维度单列，不产出信用评级。"
    },
    {
      "id": "C02",
      "agent": "contract",
      "title": "应收与未缴",
      "role": "收费 / 财务",
      "question": "这份合同哪些账单还没交费？",
      "data": "账单ID、费用项、计费期、应收、到期日、核销分配",
      "flow": "账单余额汇总 → 区分未到期/逾期 → 下钻明细",
      "accept": "HT-A01仅B-A01-03欠20,000元；历史迟付已结清账单不算欠费。",
      "boundary": "作废账单排除；到账待分配不自动抵减。"
    },
    {
      "id": "C03",
      "agent": "contract",
      "title": "逾期催缴",
      "role": "一线 / 负责人",
      "question": "需要催缴吗？帮我写一份催缴内容",
      "data": "逾期账单、客户、负责人、已到账待分配、催缴记录",
      "flow": "核账提示 → 选择账单 → 生成草稿 → 人工复核",
      "accept": "草稿引用合同号、账单号及20,000元；提示先核对5,000元待分配到账。",
      "boundary": "原型仅本地草稿；实际发出走原业务确认流程。"
    },
    {
      "id": "C04",
      "agent": "contract",
      "title": "续签准备",
      "role": "招商 / 管理者",
      "question": "合同快到期了吗，续签准备得怎样？",
      "data": "结束日、90天阈值、续签意向、方案审批、协议状态",
      "flow": "计算剩余天数 → 检查准备清单 → 形成待办建议",
      "accept": "HT-A01剩余53天，准备完成1/3项。",
      "boundary": "准备进度不是续签概率，不自动延长合同。"
    },
    {
      "id": "C05",
      "agent": "contract",
      "title": "付款及时性",
      "role": "财务 / 管理者",
      "question": "历史付款是否及时？",
      "data": "账单到期日、核销分配、对应到账日期",
      "flow": "按期分配金额统计 → 识别迟付 → 展示事实",
      "accept": "HT-A01按期核销70,000元，已核销80,000元，迟付已结清10,000元。",
      "boundary": "按期核销/到期应收；补录时间不替代实际到账时间。"
    },
    {
      "id": "C06",
      "agent": "contract",
      "title": "保证金核验",
      "role": "财务 / 一线",
      "question": "保证金是否交齐？",
      "data": "保证金条款、应缴、有效到账、退还/抵扣记录",
      "flow": "适用性判断 → 有效余额 → 缺口与来源",
      "accept": "HT-A01缺口10,000元；HT-C01显示来源缺失。",
      "boundary": "保证金不混入租金回款；未知值不填0。"
    },
    {
      "id": "C07",
      "agent": "contract",
      "title": "到账待分配",
      "role": "财务",
      "question": "客户说已付款，为什么仍欠费？",
      "data": "收款流水、核销分配、到账日期、合同关联",
      "flow": "区分到账与核销 → 展示差异 → 提示核对",
      "accept": "HT-A01保留20,000元逾期，同时展示5,000元待分配。",
      "boundary": "需要财务正式核销后刷新，不自动修改账。"
    },
    {
      "id": "C08",
      "agent": "contract",
      "title": "企业风险与条款稳定",
      "role": "负责人 / 管理者",
      "question": "企业是否有经营风险，合同变更是否频繁？",
      "data": "统一主体标识、外部风险事件、当前合同版本与生效变更",
      "flow": "主体匹配 → 事件核验 → 分项指标 → 与付款行为联合解读",
      "accept": "HT-A01主体演示分40、合同稳定70；HT-C01缺失时显示待核验。",
      "boundary": "分级是演示规则，变更不等同违约；外部命中需核验，不作信用评级。"
    },
    {
      "id": "Q01",
      "agent": "ask",
      "title": "经营总览",
      "role": "管理者",
      "question": "当前整体经营情况如何？",
      "data": "资产、客商、合同、租金账单、核销",
      "flow": "授权过滤 → 多域聚合 → 结论/指标/项目表",
      "accept": "7合同、3客商、应收500,000元、核销452,000元。",
      "boundary": "每个指标明确口径与截至时间。"
    },
    {
      "id": "Q02",
      "agent": "ask",
      "title": "欠费催缴分布",
      "role": "一线 / 管理者",
      "question": "目前哪些合同欠费，需要催缴？",
      "data": "账单、核销、到期日、合同、客商、项目",
      "flow": "余额过滤 → 合同/项目聚合 → 合同下钻",
      "accept": "4份合同逾期48,000元；海淀科技园 26,000元、B 22,000元。",
      "boundary": "授权项目内查询；零余额不进入催缴清单。"
    },
    {
      "id": "Q03",
      "agent": "ask",
      "title": "回款分析",
      "role": "财务 / 管理者",
      "question": "各项目回款情况怎么样？",
      "data": "应收账单、核销、项目归属",
      "flow": "统一期间 → 项目分组 → 金额/回款率",
      "accept": "海淀科技园应收300,000元、核销274,000元、回款率91.33%。",
      "boundary": "不以银行流水总额替代已核销。"
    },
    {
      "id": "Q04",
      "agent": "ask",
      "title": "企业关联合同",
      "role": "招商 / 管理者",
      "question": "远景科技签了哪些合同，回款怎么样？",
      "data": "客商ID、签约关系、合同、账单、核销",
      "flow": "主体消歧 → 关联合同 → 分合同对比/总计",
      "accept": "全部范围远景3份合同，应收200,000元；创智中心仅1份、20,000元。",
      "boundary": "同名需澄清；同合同多资源关联不得重复汇总。"
    },
    {
      "id": "Q05",
      "agent": "ask",
      "title": "到期统筹",
      "role": "招商 / 管理者",
      "question": "90天内哪些合同到期？",
      "data": "合同结束日、合同状态、负责人、准备清单",
      "flow": "到期窗口过滤 → 按剩余天数排序 → 单合同跳转",
      "accept": "固定日期下4份合同在90天内到期，2份在30天内。",
      "boundary": "到期日与续签状态分开展示。"
    },
    {
      "id": "Q06",
      "agent": "ask",
      "title": "资产出租与空置",
      "role": "招商 / 管理者",
      "question": "资产出租率多少，哪里空置？",
      "data": "可租资产、面积快照、有效租用关系",
      "flow": "资产去重 → 可租/已租面积 → 项目/资产明细",
      "accept": "可租10,000㎡，已租7,200㎡，出租率72%。",
      "boundary": "台账数量与面积出租率不混用。"
    },
    {
      "id": "Q09",
      "agent": "ask",
      "title": "连续追问与会话回看",
      "role": "所有用户",
      "question": "按项目展开；查看上次查询结果",
      "data": "会话ID、上下文、授权范围、结果快照、时间",
      "flow": "继承意图 → 补充维度 → 保存快照 → 回看",
      "accept": "欠费问题后追问按项目分组仍为欠费分析；右侧点历史恢复原结果。",
      "boundary": "历史不自动更新；重新查询形成新快照。"
    },
    {
      "id": "Q10",
      "agent": "ask",
      "title": "数据不足与澄清",
      "role": "所有用户",
      "question": "今年收入同比增长多少？",
      "data": "指标目录、可用期间、数据覆盖",
      "flow": "识别口径/来源缺失 → 说明缺口 → 建议替代问题",
      "accept": "当前单期样例返回缺少去年同期，不生成增长率。",
      "boundary": "不支持问题需澄清，不展示伪造图表。"
    },
    {
      "id": "Q11",
      "agent": "ask",
      "title": "授权与空结果",
      "role": "业务 / 管理者",
      "question": "新城中心回款情况；逾期超过100万元的合同",
      "data": "服务端授权范围、指标查询状态、筛选条件",
      "flow": "先鉴权 → 有权再查询 → 区分拒绝/空结果/来源缺失",
      "accept": "无权限不返回指标；无匹配合同明确为空，不伪造数值。",
      "boundary": "页面不提供授权项目选择器；生产权限必须在服务端执行。"
    },
    {
      "id": "Q12",
      "agent": "ask",
      "title": "年底待回收计划",
      "role": "财务 / 管理者",
      "question": "年底前还有多少账单待回收？",
      "data": "已到期账单、年底前已生成未到期账单、核销分配",
      "flow": "区分到期状态 → 计算计划余额 → 账单下钻",
      "accept": "逾期48,000元 + 未到期90,000元 = 138,000元。",
      "boundary": "账单计划不等于实际回款预测，未生成账单不纳入。"
    }
  ],
