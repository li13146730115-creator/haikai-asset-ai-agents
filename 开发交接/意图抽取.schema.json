{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "object_level": {
      "enum": [
        "CONTRACT",
        "ENTERPRISE",
        "COLLECTION",
        "UNKNOWN"
      ]
    },
    "task": {
      "enum": [
        "RISK",
        "OVERVIEW",
        "UNSETTLED",
        "DIMENSIONS"
      ]
    },
    "entity_mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slots": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "responsibility": {
          "enum": [
            "SELF",
            "ALL_VISIBLE",
            "UNSPECIFIED"
          ]
        },
        "role_scope": {
          "type": "array",
          "items": {
            "enum": [
              "SIGNATORY",
              "JOINT_SIGNATORY",
              "PAYER",
              "USER",
              "GUARANTOR"
            ]
          }
        },
        "project_mentions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "as_of",
        "responsibility",
        "role_scope",
        "project_mentions"
      ],
      "additionalProperties": false
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "clarification_question": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "object_level",
    "task",
    "entity_mentions",
    "slots",
    "needs_clarification",
    "clarification_question"
  ],
  "additionalProperties": false
}
