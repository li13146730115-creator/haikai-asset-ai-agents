{
  "schema_version":"agent-workflow-1.0",
  "runtime":{"business_timezone":"customer_config","default_as_of":"business_day","max_tool_calls":12,"max_model_format_repair":1,"memory":{"store":["conversation_id","last_analysis_id","scope_fingerprint","draft_id"],"never_store":["access_token","unscoped_contract_data"]}},
  "router":{"input":"user_text + trusted_context","output_schema":"意图输出.schema.json","routes":{"CONTRACT":"A1","ENTERPRISE|COLLECTION|COMPARE":"A2","UNKNOWN":"clarification"}},
  "A1合同履约助手":{"nodes":["A1-00 trusted_context","A1-01 intent","A1-02 T01 resolve contract","A1-03 authorize and freeze context","A1-04 T02 facts","A1-05 optional T09 obligations","A1-06 T03 performance","A1-07 explanation","A1-08 result validation","A1-09 drilldown or draft"],"guards":["one contract_id before T02/T03","same snapshot or return STALE_SNAPSHOT","SKIPPED_REQUIRED_DATA_MISSING cannot be rendered as safe","write requires confirmation context"]},
  "A2企业经营与合同洞察助手":{"nodes":["A2-00 trusted_context","A2-01 intent","A2-02 T01 resolve enterprise and roles","A2-03 intersect authorization and responsibility","A2-04 T04 collection query","A2-05 T05 dimensions","A2-06 optional T07 comparison","A2-07 T06 drilldown","A2-08 explanation and result validation","A2-09 handoff contract_id to A1"],"guards":["enterprise is organization unit","dedup by contract/bill IDs before aggregation","unknown, unavailable and zero are distinct","all drilldowns reauthorize","global risk/unsettled list stays in A2 until a contract is selected"]},
  "degrade":{"AUTH_REQUIRED":"stop","NOT_ACCESSIBLE":"uniform message","NEEDS_CLARIFICATION":"visible candidates only","PARTIAL":"return known components and coverage","UNAVAILABLE":"return component unavailable","ERROR":"do not convert to zero","REVISION_CONFLICT":"recheck before submission"}
}
