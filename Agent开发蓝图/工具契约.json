{
  "schema_version": "agent-tools-1.0",
  "security": {
    "identity_injected_by_backend": true,
    "model_may_not_set": [
      "principal_id",
      "tenant_id",
      "scope_ref",
      "arbitrary_sql",
      "arbitrary_url"
    ]
  },
  "common_response": {
    "required": [
      "request_id",
      "schema_version",
      "snapshot_id",
      "business_as_of",
      "query_context",
      "source_watermarks",
      "component_status",
      "data",
      "evidence_refs"
    ],
    "amount_unit": "CNY_fen_or_decimal_string",
    "ratio_requires": [
      "num",
      "den",
      "unit",
      "status",
      "num_unit",
      "den_unit"
    ]
  },
  "tools": [
    {
      "id": "T01",
      "name": "resolve_business_entity",
      "read_only": true,
      "output": [
        "candidates[].stable_id",
        "candidates[].display_name",
        "candidates[].verified_status",
        "responsibility_status",
        "mapping_status"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "object_type": {
            "enum": [
              "CONTRACT",
              "ENTERPRISE",
              "RESOURCE"
            ]
          },
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "entry_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "filters": {
            "type": "object",
            "properties": {
              "project_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "maxItems": 100
              },
              "fee_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "maxItems": 100
              },
              "contract_stages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "maxItems": 100
              },
              "responsibility": {
                "enum": [
                  "SELF",
                  "TEAM",
                  "ALL_VISIBLE"
                ]
              },
              "has_unsettled": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "page": {
            "type": "object",
            "properties": {
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "cursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "size"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "object_type"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "keyword"
            ]
          },
          {
            "required": [
              "entry_id"
            ]
          },
          {
            "required": [
              "filters"
            ]
          }
        ]
      },
      "input_notes": {
        "object_type": "CONTRACT|ENTERPRISE|RESOURCE",
        "keyword": "string",
        "filters": "scoped object",
        "page": {
          "size": "integer<=50",
          "cursor": "string|null"
        }
      },
      "side_effect": "READ_OR_DERIVE_ONLY",
      "runtime_validation": [
        "reauthorize_each_call",
        "validate_references_belong_to_current_scope",
        "check_snapshot_and_source_versions"
      ]
    },
